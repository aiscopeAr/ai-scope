generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Category {
  id           String         @id @default(cuid())
  name         String
  nameAr       String
  slug         String         @unique
  articles     Article[]
  sources      Source[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

model Source {
  id           String         @id @default(cuid())
  name         String
  rssUrl       String
  website      String?
  enabled      Boolean        @default(true)
  priority     Int            @default(5)
  categoryId   String?
  category     Category?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  lastSyncedAt DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  queueItems   ArticleQueue[]

  @@index([enabled])
}

model Article {
  id          String    @id @default(cuid())
  title       String
  titleAr     String
  slug        String    @unique
  content     String    @db.Text
  contentAr   String    @db.Text
  excerpt     String?   @db.Text
  imageUrl    String?
  sourceUrl   String
  sourceName  String
  tags        String[]
  score       Int       @default(0)
  viewCount   Int       @default(0)
  published   Boolean   @default(false)
  publishedAt DateTime?
  categoryId  String
  category    Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([published, publishedAt])
  @@index([categoryId])
}

model ArticleQueue {
  id                 String    @id @default(cuid())
  sourceUrl          String    @unique
  rawTitle           String?
  rawContent         String    @db.Text
  rawPublishedAt     DateTime?
  sourceName         String?
  sourceId           String?
  source             Source?   @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  titleAr            String?
  summaryAr          String?   @db.Text
  contentAr          String?   @db.Text
  tags               String[]
  seoTitle           String?
  seoDescription     String?
  suggestedCategory  String?
  slug               String?
  featuredImagePrompt String?
  imageUrl           String?
  translatedContent  String?   @db.Text
  status             String    @default("pending")
  retryCount         Int       @default(0)
  failureReason      String?
  processedAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @default(now()) @updatedAt
  approvedAt         DateTime?

  @@index([status])
  @@index([sourceId])
}

model Settings {
  id               String   @id @default(cuid())
  autoPublish      Boolean  @default(true)
  minScore         Int      @default(7)
  publishInterval  Int      @default(60)
  translationModel String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model SocialAccount {
  id           String       @id @default(cuid())
  platform     String       // "twitter" | "instagram" | "telegram" | "facebook" | "tiktok"
  name         String
  enabled      Boolean      @default(false)
  credentials  String       @db.Text // JSON — API keys (encrypted at app level)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  posts        SocialPost[]

  @@index([platform, enabled])
}

model SocialPost {
  id          String    @id @default(cuid())
  articleId   String
  accountId   String
  account     SocialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  platform    String
  caption     String    @db.Text
  status      String    @default("pending") // "pending" | "approved" | "sent" | "failed" | "skipped"
  sentAt      DateTime?
  errorMsg    String?
  createdAt   DateTime  @default(now())

  @@index([status])
  @@index([articleId])
  @@index([accountId])
}

model AdSlot {
  id        String   @id @default(cuid())
  name      String
  position  String
  type      String   @default("script")
  code      String   @db.Text
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([position, enabled])
}

model PromptCategory {
  id          String   @id @default(cuid())
  name        String
  nameAr      String
  slug        String   @unique
  icon        String?
  description String?
  prompts     Prompt[]

  @@index([slug])
}

model AIModel {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  icon        String?
  description String?
  prompts     Prompt[]

  @@index([slug])
}

model Prompt {
  id            String         @id @default(cuid())
  title         String
  titleAr       String
  slug          String         @unique
  description   String         @db.Text
  descriptionAr String         @db.Text
  promptText    String         @db.Text
  promptTextAr  String         @db.Text
  examples      Json?
  useCases      Json?
  culturalNotes String?        @db.Text
  sourceUrl     String
  sourceName    String
  categoryId    String
  category      PromptCategory @relation(fields: [categoryId], references: [id])
  aiModelId     String
  aiModel       AIModel        @relation(fields: [aiModelId], references: [id])
  tags          String[]
  difficulty    String         @default("intermediate")
  viewCount     Int            @default(0)
  copyCount     Int            @default(0)
  featured      Boolean        @default(false)
  published     Boolean        @default(true)
  publishedAt   DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([categoryId])
  @@index([aiModelId])
  @@index([featured])
  @@index([slug])
  @@index([published, publishedAt])
}

model PromptQueue {
  id            String    @id @default(cuid())
  rawTitle      String
  rawPrompt     String    @db.Text
  rawCategory   String?
  rawTags       String[]
  sourceUrl     String
  sourceName    String
  titleAr       String?
  descriptionAr String?   @db.Text
  promptText    String?   @db.Text
  promptTextAr  String?   @db.Text
  examples      Json?
  useCases      Json?
  culturalNotes String?   @db.Text
  score         Int       @default(0)
  status        String    @default("pending")
  difficulty    String?
  tags          String[]
  createdAt     DateTime  @default(now())
  processedAt   DateTime?

  @@index([status])
  @@index([score])
}

model PromptSource {
  id        String    @id @default(cuid())
  name      String
  type      String
  url       String
  config    Json?
  active    Boolean   @default(true)
  priority  Int       @default(5)
  lastFetch DateTime?
  createdAt DateTime  @default(now())

  @@index([active])
}

model TrendingKeyword {
  id        String   @id @default(cuid())
  keyword   String
  count     Int      @default(1)
  type      String   @default("tag")
  createdAt DateTime @default(now())

  @@unique([keyword, type])
  @@index([type, count])
}
