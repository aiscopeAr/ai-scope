generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Category {
  id           String         @id @default(cuid())
  name         String
  nameAr       String
  slug         String         @unique
  articles     Article[]
  sources      Source[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

model Source {
  id           String         @id @default(cuid())
  name         String
  rssUrl       String
  website      String?
  enabled      Boolean        @default(true)
  priority     Int            @default(5)
  categoryId   String?
  category     Category?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  lastSyncedAt DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  queueItems   ArticleQueue[]

  @@index([enabled])
}

model Article {
  id           String    @id @default(cuid())
  title        String
  titleAr      String
  slug         String    @unique
  content      String    @db.Text
  contentAr    String    @db.Text
  excerpt      String?   @db.Text
  imageUrl     String?
  imageAlt     String?
  sourceUrl    String
  sourceName   String
  tags         String[]
  keywords     String[]
  faq          Json?
  relatedTopics String[]
  score        Int       @default(0)
  viewCount    Int       @default(0)
  published    Boolean   @default(false)
  publishedAt  DateTime?
  categoryId   String
  category     Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([published, publishedAt])
  @@index([categoryId])
}

model ArticleQueue {
  id                 String    @id @default(cuid())
  sourceUrl          String    @unique
  rawTitle           String?
  rawContent         String    @db.Text
  rawPublishedAt     DateTime?
  sourceName         String?
  sourceId           String?
  source             Source?   @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  titleAr            String?
  summaryAr          String?   @db.Text
  contentAr          String?   @db.Text
  tags               String[]
  keywords           String[]
  faq                Json?
  imageAlt           String?
  relatedTopics      String[]
  seoTitle           String?
  seoDescription     String?
  suggestedCategory  String?
  slug               String?
  featuredImagePrompt String?
  imageUrl           String?
  translatedContent  String?   @db.Text
  status             String    @default("pending")
  retryCount         Int       @default(0)
  failureReason      String?
  processedAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @default(now()) @updatedAt
  approvedAt         DateTime?

  @@index([status])
  @@index([sourceId])
}

model Settings {
  id               String   @id @default(cuid())
  autoPublish      Boolean  @default(true)
  minScore         Int      @default(7)
  publishInterval  Int      @default(60)
  translationModel String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model SocialAccount {
  id           String       @id @default(cuid())
  platform     String       // "twitter" | "instagram" | "telegram" | "facebook" | "tiktok"
  name         String
  enabled      Boolean      @default(false)
  credentials  String       @db.Text // JSON — API keys (encrypted at app level)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  posts        SocialPost[]

  @@index([platform, enabled])
}

model SocialPost {
  id          String    @id @default(cuid())
  articleId   String
  accountId   String
  account     SocialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  platform    String
  caption     String    @db.Text
  status      String    @default("pending") // "pending" | "approved" | "sent" | "failed" | "skipped"
  sentAt      DateTime?
  errorMsg    String?
  createdAt   DateTime  @default(now())

  @@index([status])
  @@index([articleId])
  @@index([accountId])
}

model AdSlot {
  id        String   @id @default(cuid())
  name      String
  position  String
  type      String   @default("script")
  code      String   @db.Text
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([position, enabled])
}

model PromptCategory {
  id          String   @id @default(cuid())
  name        String
  nameAr      String
  slug        String   @unique
  icon        String?
  description String?
  prompts     Prompt[]

  @@index([slug])
}

model AIModel {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  icon        String?
  description String?
  prompts     Prompt[]

  @@index([slug])
}

model Prompt {
  id            String         @id @default(cuid())
  title         String
  titleAr       String
  slug          String         @unique
  description   String         @db.Text
  descriptionAr String         @db.Text
  promptText    String         @db.Text
  promptTextAr  String         @db.Text
  examples      Json?
  useCases      Json?
  culturalNotes String?        @db.Text
  sourceUrl     String
  sourceName    String
  categoryId    String
  category      PromptCategory @relation(fields: [categoryId], references: [id])
  aiModelId     String
  aiModel       AIModel        @relation(fields: [aiModelId], references: [id])
  tags          String[]
  difficulty    String         @default("intermediate")
  viewCount     Int            @default(0)
  copyCount     Int            @default(0)
  featured      Boolean        @default(false)
  published     Boolean        @default(true)
  publishedAt   DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([categoryId])
  @@index([aiModelId])
  @@index([featured])
  @@index([slug])
  @@index([published, publishedAt])
}

model PromptQueue {
  id            String    @id @default(cuid())
  rawTitle      String
  rawPrompt     String    @db.Text
  rawCategory   String?
  rawTags       String[]
  sourceUrl     String
  sourceName    String
  titleAr       String?
  descriptionAr String?   @db.Text
  promptText    String?   @db.Text
  promptTextAr  String?   @db.Text
  examples      Json?
  useCases      Json?
  culturalNotes String?   @db.Text
  score         Int       @default(0)
  status        String    @default("pending")
  difficulty    String?
  tags          String[]
  createdAt     DateTime  @default(now())
  processedAt   DateTime?

  @@index([status])
  @@index([score])
}

model PromptSource {
  id        String    @id @default(cuid())
  name      String
  type      String
  url       String
  config    Json?
  active    Boolean   @default(true)
  priority  Int       @default(5)
  lastFetch DateTime?
  createdAt DateTime  @default(now())

  @@index([active])
}

model TrendingKeyword {
  id        String   @id @default(cuid())
  keyword   String
  count     Int      @default(1)
  type      String   @default("tag")
  createdAt DateTime @default(now())

  @@unique([keyword, type])
  @@index([type, count])
}

// ─── Evergreen content ────────────────────────────────────────────────────────

model AITool {
  id              String   @id @default(cuid())
  name            String
  slug            String   @unique
  tagline         String?
  descriptionAr   String   @db.Text
  contentAr       String?  @db.Text   // Long-form Arabic review (800+ words)
  website         String?
  logoUrl         String?
  screenshots     String[]             // Array of image URLs
  toolCategory    String   @default("other") // 18-category taxonomy (see TOOL_CATEGORIES)
  category        String   @default("other") // Legacy field kept for compat
  pricing         String   @default("freemium") // "free" | "freemium" | "paid"
  monthlyPrice    Float?               // Starting price in USD
  pricingDetails  String?  @db.Text   // Markdown pricing tiers
  pros            String[]
  cons            String[]
  useCases        String[]
  arabicSupport   Boolean  @default(false)
  hasApi          Boolean  @default(false)
  tags            String[]
  faq             Json?                // [{question, answer}]
  seoTitle        String?
  seoDescription  String?
  imageAlt        String?
  relatedTopics   String[]
  featured        Boolean  @default(false)
  editorPick      Boolean  @default(false)
  featuredAt      DateTime?
  published       Boolean  @default(true)
  viewCount       Int      @default(0)
  likes           Int      @default(0)
  releaseDate     DateTime?
  lastUpdated     DateTime?
  sourceUrl       String?              // Original listing URL (Product Hunt, Futurepedia, etc.)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  comparisons     ComparisonSide[]

  @@index([toolCategory, published])
  @@index([category, published])
  @@index([slug])
  @@index([published, viewCount])
  @@index([published, likes])
  @@index([featured, published])
  @@index([editorPick, published])
}

model Company {
  id              String   @id @default(cuid())
  name            String
  slug            String   @unique
  descriptionAr   String   @db.Text
  website         String?
  logoUrl         String?
  country         String?
  founded         Int?
  specialties     String[] // Arabic tags
  notableModels   String[]
  published       Boolean  @default(true)
  viewCount       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([slug])
  @@index([published])
}

model Guide {
  id              String   @id @default(cuid())
  title           String
  slug            String   @unique
  excerpt         String   @db.Text
  content         String   @db.Text
  category        String   // "beginner" | "advanced" | "tutorial" | "how-to" | "comparison"
  tags            String[]
  difficulty      String   @default("beginner") // "beginner" | "intermediate" | "advanced"
  faq             Json?
  readingTime     Int?     // minutes
  published       Boolean  @default(true)
  publishedAt     DateTime @default(now())
  viewCount       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([category, published])
  @@index([slug])
  @@index([published, publishedAt])
}

model Comparison {
  id              String           @id @default(cuid())
  slug            String           @unique
  title           String
  summaryAr       String           @db.Text
  verdict         String?          @db.Text
  criteria        Json?            // { name: string, weights: number }[]
  published       Boolean          @default(true)
  viewCount       Int              @default(0)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  sides           ComparisonSide[]

  @@index([slug])
  @@index([published])
}

model ComparisonSide {
  id           String     @id @default(cuid())
  comparisonId String
  comparison   Comparison @relation(fields: [comparisonId], references: [id], onDelete: Cascade)
  toolId       String
  tool         AITool     @relation(fields: [toolId], references: [id], onDelete: Cascade)
  score        Int?       // 0–100 overall score
  notes        String?    @db.Text
  strengths    String[]
  weaknesses   String[]
  bestFor      String?

  @@unique([comparisonId, toolId])
  @@index([comparisonId])
  @@index([toolId])
}

// Tracks tool view/like events for analytics
model ToolEvent {
  id        String   @id @default(cuid())
  toolId    String
  type      String   // "view" | "like" | "click"
  createdAt DateTime @default(now())

  @@index([toolId, type])
  @@index([createdAt])
}
